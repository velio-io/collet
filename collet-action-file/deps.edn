{:collet/artifact
 {:description       "File actions for Collet"
  :public-namespaces [collet.actions.file]
  :publish?          true
  :kind              :library
  :catalogue         "collet/catalogue/collet-action-file.edn"}

 :paths ["src" "resources"]
 :deps {org.clojure/clojure         {:mvn/version "1.12.6"}
        io.velio/collet-core        {:local/root "../collet-core"}
        io.velio/collet-action-http {:local/root "../collet-action-http"}
        com.cnuernber/charred       {:mvn/version "1.043"}
        techascent/tech.ml.dataset  {:mvn/version "8.027"}}
 :aliases
 {:test        {:extra-paths ["test"]
                :extra-deps  {io.velio/collet-test-fixtures {:local/root "../test-fixtures"}
                              io.velio/collet-action-jdbc   {:local/root "../collet-action-jdbc"}}
                :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                              "--enable-native-access=ALL-UNNAMED"]
                :main-opts   ["-m" "cognitect.test-runner"]}
  :integration {}}}
