{:collet/artifact
 {:description       "Lucene actions for Collet"
  :public-namespaces [collet.actions.lucene]
  :publish?          true
  :kind              :library
  :catalogue         "collet/catalogue/collet-action-lucene.edn"}

 :paths ["src" "resources"]
 :deps {org.clojure/clojure                  {:mvn/version "1.12.6"}
        io.velio/collet-core                 {:local/root "../collet-core"}
        metosin/malli                        {:mvn/version "0.20.3"}
        techascent/tech.ml.dataset           {:mvn/version "8.027"}
        org.apache.lucene/lucene-core        {:mvn/version "10.5.2"}
        org.apache.lucene/lucene-queryparser {:mvn/version "10.5.2"}
        org.apache.lucene/lucene-analysis-common {:mvn/version "10.5.2"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.velio/collet-test-fixtures {:local/root "../test-fixtures"}}
         :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"]
         :main-opts   ["-m" "cognitect.test-runner"]}}}
