{:collet/artifact
 {:description       "SPARQL query, update and formatting actions for Collet"
  :public-namespaces [collet.actions.sparql]
  :publish?          true
  :initial-release?  true
  :kind              :library
  :catalogue         "collet/catalogue/collet-action-sparql.edn"}
 :paths ["src" "resources"]
 :deps {org.clojure/clojure                  {:mvn/version "1.12.6"}
        io.velio/collet-core                 {:local/root "../collet-core"}
        io.velio/collet-action-http          {:local/root "../collet-action-http"}
        com.cnuernber/charred                {:mvn/version "1.043"}
        com.yetanalytics/flint               {:mvn/version "0.3.1" :exclusions [org.clojure/clojurescript]}
        org.eclipse.rdf4j/rdf4j-rio-turtle   {:mvn/version "6.1.0"}
        org.eclipse.rdf4j/rdf4j-rio-ntriples {:mvn/version "6.1.0"}
        org.eclipse.rdf4j/rdf4j-rio-jsonld   {:mvn/version "6.1.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.velio/collet-test-fixtures {:local/root "../test-fixtures"}}
         :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"]
         :main-opts   ["-m" "cognitect.test-runner"]}}}
