{:collet/artifact
 {:description       "JDBC actions for Collet"
  :public-namespaces [collet.actions.jdbc collet.actions.jdbc-pg]
  :publish?          true
  :kind              :library
  :catalogue         "collet/catalogue/collet-action-jdbc.edn"}

 :paths ["src" "resources"]
 :deps {org.clojure/clojure               {:mvn/version "1.12.6"}
        io.velio/collet-core              {:local/root "../collet-core"}
        com.cnuernber/charred             {:mvn/version "1.043"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        com.github.seancorfield/honeysql  {:mvn/version "2.7.1479"}
        techascent/tech.ml.dataset        {:mvn/version "8.027"}
        org.postgresql/postgresql         {:mvn/version "42.7.14"}}
 :aliases
 {:test        {:extra-paths ["test"]
                :extra-deps  {io.velio/collet-test-fixtures {:local/root "../test-fixtures"}
                              com.mysql/mysql-connector-j   {:mvn/version "9.7.0"}}
                :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                              "--enable-native-access=ALL-UNNAMED"]
                :main-opts   ["-m" "cognitect.test-runner"]}
  :integration {}}}
